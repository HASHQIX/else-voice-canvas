NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/else.sqlite
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STT_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_STT_MODEL=universal-3-6-pro
LLM_PROVIDER=anthropic
VECTRUST_API_KEY=
ANTHROPIC_BASE_URL=https://api.openai-next.com
LLM_MODEL=claude-opus-5-5
# Optional alternative external adapter when explicitly selected.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
SESSION_SECRET=
DEMO_ACCESS_CODE=
SESSION_MAX_SECONDS=600
GUEST_RETENTION_DAYS=7
PREVIEW_INTERVAL_MS=1500
PREVIEW_MAX_PER_MINUTE=30
FINAL_MAX_PER_MINUTE=12
MAX_NODES=200
MAX_BRANCHES=8
MAX_CONCURRENT_SESSIONS=3
# Operator-approved daily cap for planner/TTS calls. AssemblyAI STT is not capped by this app budget.
DAILY_LLM_BUDGET_USD=20
# Legacy alias; use DAILY_LLM_BUDGET_USD for new deployments.
DAILY_BUDGET_USD=
